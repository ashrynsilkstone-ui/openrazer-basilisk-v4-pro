#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Builds for a selected Slackware kernel with its configured build tree.
set -eu

VERSION=3.12.4.20261120
BUILD=${BUILD:-1}
TAG=${TAG:-_basilisk}
ARCH=${ARCH:-$(uname -m)}
KERNEL=${KERNEL:-$(uname -r)}
KERNELDIR=${KERNELDIR:-/lib/modules/$KERNEL/build}
OUTPUT=${OUTPUT:-/tmp}
archive=${1:-openrazer-$VERSION.tar.xz}
tree=$(mktemp -d)
trap 'rm -rf -- "$tree"' EXIT
trap 'exit 1' HUP INT TERM

tar -xf "$archive" -C "$tree"
pkg="$tree/pkg"
mkdir -p "$OUTPUT" "$pkg/install"
OUTPUT=$(CDPATH= cd -- "$OUTPUT" && pwd)
cd "$tree/openrazer-$VERSION"
make KERNELDIR="$KERNELDIR" driver
moddir="/lib/modules/$KERNEL/extra/openrazer"
install -d "$pkg/$moddir"
make KERNELDIR="$KERNELDIR" MODULEDIR="$moddir" DESTDIR="$pkg" driver_install_packaging
make DESTDIR="$pkg" udev_install daemon_install python_library_install xdg_install appstream_install
rm -rf "$pkg/usr/lib/systemd"
if [ -d "$pkg/usr/share/man" ]; then
    mv "$pkg/usr/share/man" "$pkg/usr/man"
fi
install -Dm644 LICENSES/GPL-2.0-or-later.txt "$pkg/usr/doc/openrazer-$VERSION/COPYING"
install -Dm644 README.md "$pkg/usr/doc/openrazer-$VERSION/README.md"
cat > "$pkg/install/doinst.sh" <<POST
if [ -x /sbin/depmod ]; then
    /sbin/depmod -b . -a '$KERNEL'
fi
POST
cat > "$pkg/install/slack-desc" <<'DESC'
openrazer: openrazer (Basilisk V4 Pro test build)
openrazer:
openrazer: OpenRazer kernel modules, user-session daemon, udev rules and
openrazer: Python bindings. The modules target the kernel used for this build.
openrazer:
openrazer: Add your user to plugdev and log in again to use these devices.
openrazer:
openrazer:
openrazer:
openrazer:
openrazer:
DESC
cd "$pkg"
makepkg -l y -c n "$OUTPUT/openrazer-$VERSION-$ARCH-$BUILD$TAG.txz"
